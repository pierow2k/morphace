---
import "../styles/global.css";

const navItems = [
  { label: "Try it Now", href: "/quick-start/" },
  { label: "Documentation", href: "/documentation/" },
  { label: "Gallery", href: "/gallery/" },
  {
    label: "GitHub",
    href: "https://github.com/pierow2k/morphace",
    icon: "github",
    ariaLabel: "Morphace on GitHub",
    external: true,
  },
];

const features = [
  {
    title: "Smooth morph videos",
    body: "Turn two face images into an MP4 transition with adjustable duration and frame rate.",
  },
  {
    title: "Face-focused prep",
    body: "Optionally align and crop portraits first so the morph stays focused on the faces, not the background.",
  },
  {
    title: "Automatic face alignment",
    body: "Detect facial features and align both images to create a cleaner, more natural transition.",
  },
  {
    title: "CLI and Python API",
    body: "Generate videos from the command line or integrate Morphace into your own Python workflow.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Morphace is an open-source Python tool for generating landmark-based face-morphing videos."
    />
    <link rel="apple-touch-icon" sizes="57x57" href="/favicon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/favicon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/favicon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/favicon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/favicon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/favicon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/favicon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/favicon-144x144.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <title>Morphace | Face Morphing Video Generator</title>
  </head>
  <body class="bg-sky-50 text-sky-950 antialiased">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sky-950 focus:shadow-lg"
      href="#content"
    >
      Skip to content
    </a>

    <header class="border-b border-sky-100 bg-white/90 backdrop-blur">
      <nav
        class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4"
        aria-label="Primary navigation"
      >
        <a
          href="/"
          class="font-display text-xl font-semibold tracking-normal text-sky-950 no-underline transition-colors hover:text-sky-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-500"
        >
          Morphace
        </a>
        <div class="flex flex-wrap items-center gap-2 text-sm font-semibold">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-label={item.ariaLabel}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer" : undefined}
                class={
                  item.icon === "github"
                    ? "inline-flex h-10 w-10 items-center justify-center rounded-md text-sky-800 no-underline transition-colors hover:bg-sky-100 hover:text-sky-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
                    : "rounded-md px-3 py-2 text-sky-800 no-underline transition-colors hover:bg-sky-100 hover:text-sky-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
                }
              >
                {
                  item.icon === "github" ? (
                    <svg
                      class="h-6 w-6"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        fill="currentColor"
                        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.069 1.835 2.807 1.305 3.492.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.382 1.235-3.222-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.912 1.23 3.222 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                      />
                    </svg>
                  ) : (
                    item.label
                  )
                }
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="content">
      <section class="bg-white">
        <div
          class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-12 lg:min-h-[calc(100svh-73px)] lg:grid-cols-[1fr_0.82fr] lg:py-10"
        >
          <div class="max-w-2xl">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-sky-700">
              Open-source face morphing
            </p>
            <h1
              class="font-display text-4xl font-semibold leading-tight text-sky-950 sm:text-5xl"
            >
              Turn two face photos into a smooth morphing video.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-700">
              Morphace uses facial landmark detection to align two faces, smoothly
              transition between them, and export the result as an MP4.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/quick-start/"
                class="rounded-md bg-orange-500 px-5 py-3 text-sm font-bold text-white no-underline shadow-sm transition-colors hover:bg-orange-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-500"
              >
                Try it Now
              </a>
              <a
                href="/documentation/"
                class="rounded-md border border-sky-200 bg-white px-5 py-3 text-sm font-bold text-sky-900 no-underline transition-colors hover:border-sky-400 hover:bg-sky-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-500"
              >
                Documentation
              </a>
            </div>
          </div>

          <figure
            class="order-first mx-auto w-full max-w-[420px] overflow-hidden rounded-lg border border-sky-100 bg-sky-950 shadow-xl shadow-sky-950/10 lg:order-none lg:justify-self-end"
          >
            <video
              class="aspect-[3/4] max-h-[540px] w-full bg-sky-950 object-cover"
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
              poster="/media/video-morphace-demo-poster.jpg"
              aria-label="A generated Morphace face-morphing demo video"
            >
              <source src="/media/video-morphace-demo.webm" type="video/webm" />
              <source src="/media/video-morphace-demo.mp4" type="video/mp4" />
            </video>
            <figcaption class="bg-white px-4 py-3 text-sm text-slate-600">
              Demo generated with <code>morphace</code> from two source
              portraits.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="border-y border-sky-100 bg-sky-50">
        <div class="mx-auto grid max-w-7xl gap-4 px-5 py-10 md:grid-cols-4">
          {
            features.map((feature) => (
              <article class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm">
                <h2 class="font-display text-base font-semibold text-sky-950">
                  {feature.title}
                </h2>
                <p class="mt-3 text-sm leading-6 text-slate-700">
                  {feature.body}
                </p>
              </article>
            ))
          }
        </div>
      </section>

    </main>
  </body>
</html>
